# DBZ Code environment variables
# Copy this file to .env and fill in the values.
# .env is git-ignored and should never be committed.

# Optional: override default model provider settings
# DBZ_PROVIDER=ollama
# DBZ_OLLAMA_BASE_URL=http://localhost:11434

# Optional: API keys for cloud providers (only needed if not using local models)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
