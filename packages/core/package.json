{
  "name": "@dbz-code/core",
  "version": "0.0.0",
  "private": false,
  "description": "Core runtime orchestration for DBZ Code",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "dev": "tsc --project tsconfig.build.json --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist *.tsbuildinfo",
    "test": "vitest run"
  },
  "devDependencies": {
    "rimraf": "*",
    "typescript": "*",
    "vitest": "*"
  }
}
